# Discord bot — used to post recruitment applications as the bot itself
# (same token as tss-dc-bot/.env's DISCORD_TOKEN) rather than via a webhook
DISCORD_TOKEN=your-discord-bot-token
DISCORD_RECRUITMENT_CHANNEL_ID=your-recruitment-channel-id

# Google Analytics measurement ID (gtag.js) — leave unset to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Payments (Stripe) ---
# Without STRIPE_SECRET_KEY the checkout and webhook routes answer 503.
STRIPE_SECRET_KEY=sk_live_or_test_xxx
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook
# (Stripe Dashboard > Developers > Webhooks). Enable the events:
#   checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public base URL for Stripe success/cancel redirects and email links
NEXT_PUBLIC_APP_URL=https://twostepsstudio.gg
