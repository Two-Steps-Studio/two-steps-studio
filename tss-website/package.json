{
  "name": "two-steps-studio-desktop",
  "version": "1.0.2",
  "description": "Two Steps Studio Desktop Application for Windows",
  "author": "Two Steps Studio",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "repository": {
    "type": "git",
    "url": "https://github.com/twostepsstudio/tss-desktop"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "dev": "next dev -p 6767",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "dev:electron": "next dev -p 6767",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "lint:prettier": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "lint:prettier:fix": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "electron": "cross-env ELECTRON=true electron .",
    "electron:dev": "concurrently \"cross-env ELECTRON=true npm run dev:electron\" \"wait-on http://localhost:6767 && cross-env ELECTRON=true electron .\"",
    "electron:build": "npm run build:electron && electron-builder --config electron-builder.config.cjs",
    "electron:build:win": "npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.cjs --win",
    "electron:build:win:nsis": "npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.cjs --win nsis",
    "electron:build:win:portable": "npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.cjs --win portable",
    "electron:build:mac": "npm run build:electron && electron-builder --config electron-builder.config.cjs --mac",
    "electron:build:linux": "npm run build:electron && electron-builder --config electron-builder.config.cjs --linux",
    "electron:release": "npm run build:electron && electron-builder --config electron-builder.config.cjs --publish always",
    "electron:release:win": "npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.cjs --win --publish always",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:electron": "cross-env ELECTRON=true next build",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
