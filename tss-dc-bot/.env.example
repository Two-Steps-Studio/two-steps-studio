# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Discord Bot Configuration
DISCORD_TOKEN=your-discord-bot-token

# Discord Application Configuration (for OAuth2)
CLIENT_ID=your-discord-client-id
CLIENT_SECRET=your-discord-client-secret
REDIRECT_URI=http://localhost:3456/callback

# Guild Configuration
GUILD_ID=your-discord-guild-id

# Optional: channel ID for kick/ban/timeout/warn/message-edit/message-delete
# logs. If unset, falls back to a channel named "mod-log"/"modlog"/"logi".
MOD_LOG_CHANNEL_ID=

# Optional: role ID that automatically gets access to every new ticket
# channel, alongside the ticket's own creator.
TICKET_STAFF_ROLE_ID=

# Optional: voice channel ID that triggers "join to create" - joining it
# spins up a personal temporary voice channel and moves the member into it.
# Feature is entirely disabled if unset.
JOIN_TO_CREATE_CHANNEL_ID=

# Optional: Enable/Disable features
ENABLE_FISHING=true
ENABLE_RPG=true
ENABLE_EVENTS=true
